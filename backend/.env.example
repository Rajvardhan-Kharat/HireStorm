PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hirestorm

# JWT
JWT_ACCESS_SECRET=<generate-a-strong-random-secret>
JWT_REFRESH_SECRET=<generate-a-strong-random-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis
REDIS_URL=rediss://default:<password>@<host>:<port>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email — SendGrid (optional, uses SMTP below if not set)
SENDGRID_API_KEY=<your-sendgrid-key>
SENDGRID_FROM_EMAIL=<your-verified-sender@example.com>

# Email — SMTP (Gmail recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASS=<your-gmail-app-password>

# Default Admin seed
DEFAULT_ADMIN_ID=<mongodb-objectid>

# URLs
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Razorpay (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=<your-client-id>
LINKEDIN_CLIENT_SECRET=<your-client-secret>
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/linkedin/callback

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REFRESH_TOKEN=<your-refresh-token>

# Gemini AI
GEMINI_API_KEY=<your-gemini-api-key>
